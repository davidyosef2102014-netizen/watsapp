{
  "name": "birgsol-desktop",
  "version": "1.0.0",
  "description": "BIRGSOL AI Desktop — code mode + browser agent with real terminal, files, and no-CORS network.",
  "main": "main.js",
  "author": "David Yosef Zevi — BIRGSOL",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.birgsol.desktop",
    "productName": "BIRGSOL AI",
    "files": ["main.js", "preload.js", "!nvidia.key", "!dist/**"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": true, "perMachine": false, "allowToChangeInstallationDirectory": false }
  }
}
