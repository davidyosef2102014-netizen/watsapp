  if (!msgs.some(m => m && m.role === 'system')) msgs.unshift({ role: 'system', content: BIRGSOL_SYS });
  const payload = { model: route[1], messages: msgs, temperature: b.temperature != null ? b.temperature : 0.7, max_tokens: b.max_tokens || 1024, stream: !!b.stream };
  const up = await fetch(prov.url, { method: 'POST', headers: { 'Authorization': 'Bearer ' + pick(prov.keys), 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
  if (b.stream) {
    // streaming has no final usage here → bill an estimate (rough input tokens + capped output)
    if (up.ok && _hash) { const estIn = Math.ceil(JSON.stringify(msgs).length / 4); await bill(chatCost(want, estIn, payload.max_tokens || 1024)); }
    return new Response(up.body, { status: up.status, headers: { ...cors, 'Content-Type': 'text/event-stream; charset=utf-8', 'Cache-Control': 'no-cache' } });
