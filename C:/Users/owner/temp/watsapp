// ── Key validation + credit via ONE security-definer RPC `api_charge(h, amount)` ──
// Works for EVERY registered user using only the PUBLIC anon key (no service_role needed):
//   • api_charge(hash, 0)  → current balance ($), or null if the key is invalid/revoked  (validation + pre-check)
//   • api_charge(hash, >0) → deducts (floored at 0) and returns the new balance           (per-call billing)
// The RPC (SECURITY DEFINER) looks the key's owner up by SHA-256 hash in public.api_keys, so only the holder
// of the real key can affect its own balance. Static test keys in BIRGSOL_API_KEYS bypass Supabase entirely.
function _sbUrl(env) { return String(env.SUPABASE_URL || '').replace(/\/+$/, ''); }
function _sbKey(env) { return env.SUPABASE_ANON_KEY || env.SUPABASE_SERVICE_KEY || ''; }
async function _sha256hex(s) {
  const d = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
  return [...new Uint8Array(d)].map(x => x.toString(16).padStart(2, '0')).join('');
}
async function _apiCharge(hash, amount, env) {
  if (!env.SUPABASE_URL || !_sbKey(env)) return null;
  try {
    const r = await fetch(_sbUrl(env) + '/rest/v1/rpc/api_charge', {
      method: 'POST',
      headers: { apikey: _sbKey(env), Authorization: 'Bearer ' + _sbKey(env), 'Content-Type': 'application/json' },
      body: JSON.stringify({ h: hash, amount: amount })
    });
    if (!r.ok) return null;
    const v = await r.json().catch(() => null);
    return (v == null) ? null : Number(v);
  } catch (_) { return null; }
}
// Validate a user key + read balance (null = invalid/unavailable). amount=0 → no deduction.
async function _keyBalance(hash, env) { return await _apiCharge(hash, 0, env); }
// Best-effort per-call deduction — fail-open: never throws, never blocks the API response.
async function _charge(hash, cost, env) { if (hash && cost > 0) { try { await _apiCharge(hash, Number(cost.toFixed(6)), env); } catch (_) {} } }

// PCM16 mono → WAV bytes (prepends a 44-byte header so the audio is directly playable).
function _pcmToWav(pcm, sampleRate, channels, bits) {
  const blockAlign = channels * bits / 8, byteRate = sampleRate * blockAlign, dataLen = pcm.length;
  const buf = new ArrayBuffer(44 + dataLen), dv = new DataView(buf);
  const ws = (o, s) => { for (let i = 0; i < s.length; i++) dv.setUint8(o + i, s.charCodeAt(i)); };
  ws(0, 'RIFF'); dv.setUint32(4, 36 + dataLen, true); ws(8, 'WAVE'); ws(12, 'fmt ');
  dv.setUint32(16, 16, true); dv.setUint16(20, 1, true); dv.setUint16(22, channels, true);
  dv.setUint32(24, sampleRate, true); dv.setUint32(28, byteRate, true);
  dv.setUint16(32, blockAlign, true); dv.setUint16(34, bits, true);
  ws(36, 'data'); dv.setUint32(40, dataLen, true);
  new Uint8Array(buf, 44).set(pcm);
  return new Uint8Array(buf);
}
