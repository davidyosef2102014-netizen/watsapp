    const ir = await fetch('https://birgsol-image.davidyosef2102014.workers.dev/', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Origin': 'https://davidyosef2102014-netizen.github.io' }, body: JSON.stringify({ prompt, hq: true, width: w, height: h }) });
    const ij = await ir.json().catch(() => null);
    if (!ir.ok || !ij || !ij.image) return err(502, (ij && ij.error) || 'image generation failed', 'server_error');
