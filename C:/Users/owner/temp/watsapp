  }

  // ── 🔊 VOICE — birgsol-voice-1 ──  {input, voice?}  → WAV audio
  if (url.pathname === '/v1/audio/speech') {
    const input = String(b.input || b.text || '').slice(0, 3000);
    if (!input) return err(400, 'The "input" field (text to speak) is required.', 'invalid_request_error', 'input');
    const voice = String(b.voice || 'Aoede');
    const gkeys = keysOf(env.GEMINI_KEYS).length ? keysOf(env.GEMINI_KEYS) : keysOf(env.GEMINI_KEY);
    if (!gkeys.length) return err(500, 'voice unavailable', 'server_error');
    const gr = await fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'X-goog-api-key': pick(gkeys) },
      body: JSON.stringify({ contents: [{ parts: [{ text: input }] }], generationConfig: { responseModalities: ['AUDIO'], speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: voice } } } } })
    });
    const gj = await gr.json().catch(() => null);
    const b64 = gj && gj.candidates && gj.candidates[0] && gj.candidates[0].content && gj.candidates[0].content.parts && gj.candidates[0].content.parts[0] && gj.candidates[0].content.parts[0].inlineData && gj.candidates[0].content.parts[0].inlineData.data;
    if (!gr.ok || !b64) return err(502, 'voice generation failed', 'server_error');
    const pcm = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
    await bill(0.03 * Math.max(1, input.length / 1000));
    return new Response(_pcmToWav(pcm, 24000, 1, 16), { headers: { ...cors, 'Content-Type': 'audio/wav' } });
  }

  // ── 🔎 SEARCH endpoint — POST /v1/search {query} → {query, answer, sources} ──
  if (url.pathname === '/v1/search') {
    const query = String(b.query || b.q || '').slice(0, 400);
    if (!query) return err(400, 'The "query" field is required for search.', 'invalid_request_error', 'query');
    const tks = keysOf(env.TAVILY_KEYS);
    if (!tks.length) return err(500, 'search unavailable', 'server_error');
    const tr = await fetch('https://api.tavily.com/search', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ api_key: pick(tks), query, search_depth: 'basic', include_answer: 'advanced', max_results: 6 }) });
    const tj = await tr.json().catch(() => null);
    if (!tr.ok || !tj) return err(502, 'search failed', 'server_error');
    const sources = (tj.results || []).slice(0, 6).map(r => ({ title: r.title, url: r.url }));
    await bill(0.025);
    return new Response(JSON.stringify({ query, answer: tj.answer || '', sources }), { headers: head });
  }

  // ── 💬 CHAT / 🔎 SEARCH ──
  if (url.pathname !== '/v1/chat/completions') return err(404, 'Unknown endpoint ' + url.pathname + '. Valid endpoints: /v1/chat/completions, /v1/images/generations, /v1/audio/speech, /v1/search, /v1/models.', 'invalid_request_error');
  const want = String(b.model || 'birgsol-3.5');
  const msgs = Array.isArray(b.messages) ? b.messages.slice() : [];
  if (b.model && want !== 'birgsol-search' && !CHAT[want]) return err(404, "The model '" + want + "' does not exist or is not available on BIRGSOL. See GET /v1/models for the full list.", 'model_not_found', 'model');
  if (!msgs.length) return err(400, 'The "messages" field is required and must be a non-empty array of {role, content} objects.', 'invalid_request_error', 'messages');

  // 🔎 birgsol-search — live web search returned as a chat completion
  if (want === 'birgsol-search') {
    const last = [...msgs].reverse().find(m => m && m.role === 'user');
    const query = String((last && last.content) || '').slice(0, 400);
    if (!query) return err(400, 'a user message (search query) is required');
    const tks = keysOf(env.TAVILY_KEYS);
    if (!tks.length) return err(500, 'search unavailable', 'server_error');
    const tr = await fetch('https://api.tavily.com/search', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ api_key: pick(tks), query, search_depth: 'basic', include_answer: 'advanced', max_results: 6 }) });
    const tj = await tr.json().catch(() => null);
    if (!tr.ok || !tj) return err(502, 'search failed', 'server_error');
    let answer = tj.answer || '';
    if (tj.results && tj.results.length) answer += '\n\nSources:\n' + tj.results.slice(0, 5).map(r => '• ' + r.title + ' — ' + r.url).join('\n');
    await bill(0.025);
    return new Response(JSON.stringify({ id: 'birgsol-' + Date.now(), object: 'chat.completion', created: Math.floor(Date.now() / 1000), model: want, choices: [{ index: 0, message: { role: 'assistant', content: answer || 'No results found.' }, finish_reason: 'stop' }] }), { headers: head });
  }

  // 💬 regular chat → route to the mapped provider + model
  const route = CHAT[want] || CHAT['birgsol-3.5'];

  // ── 🔵 Gemini-backed chat (e.g. birgsol-3.5-flash) — Google generateContent, adapted to OpenAI shape ──
  if (route[0] === 'gemini') {
    const gkeys = keysOf(env.GEMINI_KEYS).length ? keysOf(env.GEMINI_KEYS) : keysOf(env.GEMINI_KEY);
    if (!gkeys.length) return err(500, 'provider unavailable for ' + want, 'server_error');
    let sysText = '';
    const contents = [];
    for (const m of msgs) {
      const c = (m && typeof m.content === 'string') ? m.content : (m && Array.isArray(m.content) ? m.content.map(p => (p && p.text) || '').join(' ') : '');
      if (m && m.role === 'system') { sysText += (sysText ? '\n' : '') + c; continue; }
      contents.push({ role: (m && m.role === 'assistant') ? 'model' : 'user', parts: [{ text: String(c || '') }] });
    }
    if (!sysText) sysText = BIRGSOL_SYS;
    const _gKey = pick(gkeys);
    const _gUrl = 'https://generativelanguage.googleapis.com/v1beta/models/' + route[1] + ':generateContent';
    const _baseCfg = { temperature: b.temperature != null ? b.temperature : 0.7, maxOutputTokens: b.max_tokens || 1024 };
    const _callGemini = (cfg) => fetch(_gUrl, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-goog-api-key': _gKey }, body: JSON.stringify({ contents, systemInstruction: { parts: [{ text: sysText }] }, generationConfig: cfg }) });
    let gr = await _callGemini({ ..._baseCfg, thinkingConfig: { thinkingBudget: 0 } }); // answer directly, no thinking budget
    if (!gr.ok) gr = await _callGemini(_baseCfg); // fallback: this model may not accept thinkingConfig
    const gj = await gr.json().catch(() => null);
    if (!gr.ok || !gj) return err(502, (gj && gj.error && gj.error.message) || 'upstream error', 'server_error');
    // join only the ANSWER parts (skip "thought" parts so a thinking model's reasoning never leaks into the reply)
    const text = (((gj.candidates && gj.candidates[0] && gj.candidates[0].content && gj.candidates[0].content.parts) || []).filter(p => p && !p.thought).map(p => (p && p.text) || '').join('')) || '';
    const um = gj.usageMetadata || {}; const pin = um.promptTokenCount || 0, pout = um.candidatesTokenCount || 0;
    await bill(chatCost(want, pin, pout));
    const created = Math.floor(Date.now() / 1000), id = 'chatcmpl-' + (crypto.randomUUID ? crypto.randomUUID() : Date.now());
    if (b.stream) {
      const sse = 'data: ' + JSON.stringify({ id, object: 'chat.completion.chunk', created, model: want, choices: [{ index: 0, delta: { role: 'assistant', content: text }, finish_reason: null }] }) + '\n\n'
                + 'data: ' + JSON.stringify({ id, object: 'chat.completion.chunk', created, model: want, choices: [{ index: 0, delta: {}, finish_reason: 'stop' }] }) + '\n\n'
